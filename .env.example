# EmpSkil Environment Variables

# Backend Configuration
DATASET_PATH=empskil_dataset.csv

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Readiness Thresholds
READINESS_READY=80
READINESS_NEAR_READY=60
READINESS_DEVELOPING=40

# Gap Thresholds
GAP_NO_GAP=0
GAP_MINOR=1
GAP_MODERATE=2
GAP_MAJOR=3

# Recommendation Weights (must sum to 1.0)
WEIGHT_GAP_PRIORITY=0.30
WEIGHT_ROLE_IMPORTANCE=0.25
WEIGHT_RESOURCE_RELEVANCE=0.20
WEIGHT_DIFFICULTY_FIT=0.15
WEIGHT_LEARNING_EFFICIENCY=0.10